# Copiá este archivo como ".env" y ajustá los valores:  cp .env.example .env
# El archivo ".env" NUNCA se sube a Git (está en .gitignore): contiene secretos.

NODE_ENV=development
# Puerto donde escucha el servidor de la API
PORT=3000
# Cadena de conexión a PostgreSQL: postgres://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgres://nautiflow:nautiflow@localhost:5432/nautiflow_dev
# Dirección del frontend (React/Vite) que tiene permiso para llamar a esta API (CORS)
WEB_ORIGIN=http://localhost:5173

