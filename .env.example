# Copiá este archivo como ".env" y ajustá los valores:  cp .env.example .env
# El archivo ".env" NUNCA se sube a Git (está en .gitignore): contiene secretos.

NODE_ENV=development
# Puerto donde escucha el servidor de la API
PORT=3000
# Cadena de conexión a PostgreSQL: postgres://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgres://nautiflow:nautiflow@localhost:5432/nautiflow_dev
# Dirección del frontend (React/Vite) que tiene permiso para llamar a esta API (CORS)
WEB_ORIGIN=http://localhost:5173

# ── Sesión ──
# Clave para firmar las sesiones. GENERÁ UNA PROPIA (y distinta en producción) con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# y pegá el resultado acá. Esta de ejemplo es SOLO para desarrollo local.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-solo-desarrollo
SESSION_HOURS=12
# 'lax' en local. En producción con front y API en dominios distintos: 'none'
COOKIE_SAMESITE=lax

# ── Primer administrador (lo usa: npm run db:seed:admin) ──
ADMIN_EMAIL=admin@nautiflow.local
# Mínimo 10 caracteres. Cambiala por una tuya.
ADMIN_PASSWORD=CambiaEstaClave123
