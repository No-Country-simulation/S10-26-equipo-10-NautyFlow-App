# Variables para los TESTS. Usan una base distinta (nautiflow_test) para no tocar tus datos de desarrollo.
NODE_ENV=test
PORT=3001
DATABASE_URL=postgres://nautiflow:nautiflow@localhost:5432/nautiflow_test
WEB_ORIGIN=http://localhost:5173
# Clave de mentira, válida solo para tests (nunca se usa fuera de ellos).
JWT_SECRET=clave-solo-para-tests-de-nautiflow-0123456789
SESSION_HOURS=1
COOKIE_SAMESITE=lax
